<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mount Passengers patches. Mount Passengers is optional, and this references its DLL, so loadFolders loads it
       from its own folder only when Mount Passengers is active.

       One project, two builds (the main project reference resolves to the matching target):
       net48   -> 1.6/Mods/MountPassengers/Assemblies, against the 1.6 reference assemblies (Krafs copy).
       net10.0 -> 1.7/Mods/MountPassengers/Assemblies, against the 1.7 game root (Waylith / UnityStubs). -->
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <AssemblyName>RaceRidingRestrictions.MountPassengers</AssemblyName>
    <RootNamespace>RaceRidingRestrictions.MountPassengersCompat</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- AppendTargetFrameworkToOutputPath=false also flattens obj\, so give each target its own
         intermediate folder or the parallel net48/net10 builds overwrite each other. -->
    <IntermediateOutputPath>obj\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <RimWorld16Ref>C:\Users\DanZinagri\Documents\RimWorldModding\RimWorld-1.6-Ref</RimWorld16Ref>
    <RimWorld17Root>E:\SteamLibrary\steamapps\common\RimWorld</RimWorld17Root>
    <HarmonyRoot>E:\SteamLibrary\steamapps\workshop\content\294100\2009463077</HarmonyRoot>
    <MountPassengersRoot>E:\SteamLibrary\steamapps\workshop\content\294100\3756579512</MountPassengersRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <OutputPath>..\..\1.6\Mods\MountPassengers\Assemblies\</OutputPath>
    <FrameworkPathOverride>$(RimWorld16Ref)</FrameworkPathOverride>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <OutputPath>..\..\1.7\Mods\MountPassengers\Assemblies\</OutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorld16Ref)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(RimWorld16Ref)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="netstandard"><HintPath>$(RimWorld16Ref)\netstandard.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyRoot)\1.6\Assemblies\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MountPassengers"><HintPath>$(MountPassengersRoot)\1.6\Assemblies\MountPassengers.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorld17Root)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimWorld17Root)\UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyRoot)\1.7\Assemblies\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MountPassengers"><HintPath>$(MountPassengersRoot)\1.7\Assemblies\MountPassengers.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RaceRidingRestrictions\RaceRidingRestrictions.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
